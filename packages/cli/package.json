{
  "name": "sdeck",
  "version": "0.7.0",
  "description": "Session Deck in the terminal: background Claude Code and Copilot CLI sessions with a live preview and attach/detach, native on Windows",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/adrianogpena/session-deck.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/adrianogpena/session-deck/issues"
  },
  "homepage": "https://github.com/adrianogpena/session-deck#readme",
  "keywords": [
    "claude",
    "claude code",
    "copilot",
    "github copilot",
    "copilot cli",
    "ai",
    "agent",
    "cli",
    "terminal",
    "tui",
    "sessions",
    "session manager"
  ],
  "bin": {
    "sdeck": "out/main.js"
  },
  "main": "out/main.js",
  "files": [
    "out/main.js",
    "out/main.js.map",
    "vendor",
    "resources"
  ],
  "scripts": {
    "build": "tsc -p . && node esbuild.mjs",
    "watch": "tsc -watch -p .",
    "start": "node out/main.js",
    "pretest": "npm run build",
    "test": "node --test out/test/*.test.js",
    "lint": "eslint src",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "node-pty": "^1.1.0"
  },
  "devDependencies": {
    "@session-deck/core": "*",
    "@types/node": "^20.11.0",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/headless": "^6.0.0",
    "esbuild": "^0.28.2"
  },
  "engines": {
    "node": ">=22.5.0"
  }
}
