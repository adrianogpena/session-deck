{
  "name": "session-deck",
  "displayName": "Session Deck",
  "description": "Multi-project AI coding session explorer for Claude Code and GitHub Copilot CLI, with a single, reusable session tab",
  "version": "0.1.0",
  "private": false,
  "publisher": "adrianogpena",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/adrianogpena/session-deck.git"
  },
  "bugs": {
    "url": "https://github.com/adrianogpena/session-deck/issues"
  },
  "homepage": "https://github.com/adrianogpena/session-deck#readme",
  "icon": "resources/icon.png",
  "engines": {
    "vscode": "^1.93.0"
  },
  "categories": [
    "Chat",
    "Other"
  ],
  "keywords": [
    "claude",
    "claude code",
    "copilot",
    "github copilot",
    "copilot cli",
    "ai",
    "agent",
    "cli",
    "terminal",
    "sessions",
    "session manager",
    "multi-root"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "configuration": {
      "title": "Session Deck",
      "properties": {
        "sessionDeck.confirmDangerousSkipPermissions": {
          "type": "boolean",
          "default": true,
          "description": "Show a confirmation dialog before resuming or starting a session with --dangerously-skip-permissions."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "sessionDeck",
          "title": "Session Deck",
          "icon": "resources/icon.svg"
        }
      ]
    },
    "views": {
      "sessionDeck": [
        {
          "id": "sessionDeck.sessions",
          "name": "Sessions"
        }
      ],
      "explorer": [
        {
          "id": "sessionDeck.activeSession",
          "name": "Open Sessions",
          "visibility": "collapsed"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "sessionDeck.sessions",
        "contents": "No projects configured for this workspace yet — .vscode/session-deck.json is missing or empty.\n[Edit session-deck.json](command:sessionDeck.editProjectList)\n[Add Project](command:sessionDeck.addProject)"
      },
      {
        "view": "sessionDeck.activeSession",
        "contents": "No sessions open right now.\nStatus (running/waiting/done) shows automatically for both agents once a session is open — no setup needed."
      }
    ],
    "commands": [
      {
        "command": "sessionDeck.refresh",
        "title": "Session Deck: Refresh Sessions",
        "icon": "$(refresh)"
      },
      {
        "command": "sessionDeck.openSession",
        "title": "Session Deck: Resume Session in Terminal"
      },
      {
        "command": "sessionDeck.openSessionDangerously",
        "title": "Session Deck: Resume Session in Terminal (Skip Permissions)"
      },
      {
        "command": "sessionDeck.viewTranscript",
        "title": "Session Deck: View Transcript",
        "icon": "$(preview)"
      },
      {
        "command": "sessionDeck.search",
        "title": "Session Deck: Search Sessions",
        "icon": "$(search)"
      },
      {
        "command": "sessionDeck.addProject",
        "title": "Session Deck: Add Project to Workspace",
        "icon": "$(add)"
      },
      {
        "command": "sessionDeck.newSession",
        "title": "Session Deck: New Session",
        "icon": "$(comment-add)"
      },
      {
        "command": "sessionDeck.newSessionDangerously",
        "title": "Session Deck: New Session (Skip Permissions)"
      },
      {
        "command": "sessionDeck.editProjectList",
        "title": "Session Deck: Edit Project List (session-deck.json)",
        "icon": "$(json)"
      },
      {
        "command": "sessionDeck.renameProject",
        "title": "Session Deck: Rename Project",
        "icon": "$(rename)"
      },
      {
        "command": "sessionDeck.removeProject",
        "title": "Session Deck: Remove Project",
        "icon": "$(trash)"
      },
      {
        "command": "sessionDeck.hideProject",
        "title": "Session Deck: Hide Project",
        "icon": "$(circle-slash)"
      },
      {
        "command": "sessionDeck.renameSession",
        "title": "Session Deck: Rename Session",
        "icon": "$(rename)"
      },
      {
        "command": "sessionDeck.archiveSession",
        "title": "Session Deck: Archive Session",
        "icon": "$(file-zip)"
      },
      {
        "command": "sessionDeck.unarchiveSession",
        "title": "Session Deck: Unarchive Session",
        "icon": "$(inbox)"
      },
      {
        "command": "sessionDeck.copyLastResponse",
        "title": "Session Deck: Copy Last Response",
        "icon": "$(clippy)"
      },
      {
        "command": "sessionDeck.copySessionInfo",
        "title": "Session Deck: Copy Session Info",
        "icon": "$(clippy)"
      },
      {
        "command": "sessionDeck.forkSession",
        "title": "Session Deck: Fork Session",
        "icon": "$(git-branch)"
      },
      {
        "command": "sessionDeck.forkSessionDangerously",
        "title": "Session Deck: Fork Session (Skip Permissions)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "sessionDeck.search",
          "when": "view == sessionDeck.sessions",
          "group": "navigation"
        },
        {
          "command": "sessionDeck.addProject",
          "when": "view == sessionDeck.sessions",
          "group": "navigation"
        },
        {
          "command": "sessionDeck.editProjectList",
          "when": "view == sessionDeck.sessions",
          "group": "navigation"
        },
        {
          "command": "sessionDeck.refresh",
          "when": "view == sessionDeck.sessions",
          "group": "navigation"
        },
        {
          "command": "sessionDeck.refresh",
          "when": "view == sessionDeck.activeSession",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "sessionDeck.newSession",
          "when": "view == sessionDeck.sessions && viewItem == sessionDeckProject",
          "group": "inline@1"
        },
        {
          "command": "sessionDeck.renameProject",
          "when": "view == sessionDeck.sessions && viewItem == sessionDeckProject",
          "group": "inline@2"
        },
        {
          "command": "sessionDeck.removeProject",
          "when": "view == sessionDeck.sessions && viewItem == sessionDeckProject",
          "group": "inline@3"
        },
        {
          "command": "sessionDeck.newSession",
          "when": "view == sessionDeck.sessions && viewItem == sessionDeckProject",
          "group": "1_session"
        },
        {
          "command": "sessionDeck.renameProject",
          "when": "view == sessionDeck.sessions && viewItem == sessionDeckProject",
          "group": "2_modification"
        },
        {
          "command": "sessionDeck.removeProject",
          "when": "view == sessionDeck.sessions && viewItem == sessionDeckProject",
          "group": "2_modification"
        },
        {
          "command": "sessionDeck.hideProject",
          "when": "view == sessionDeck.sessions && viewItem == sessionDeckProject",
          "group": "2_modification"
        },
        {
          "command": "sessionDeck.newSessionDangerously",
          "when": "view == sessionDeck.sessions && viewItem == sessionDeckProject",
          "group": "3_danger"
        },
        {
          "command": "sessionDeck.viewTranscript",
          "when": "view == sessionDeck.sessions && viewItem == sessionDeckSession",
          "group": "inline@1"
        },
        {
          "command": "sessionDeck.renameSession",
          "when": "view == sessionDeck.sessions && viewItem == sessionDeckSession",
          "group": "inline@2"
        },
        {
          "command": "sessionDeck.archiveSession",
          "when": "view == sessionDeck.sessions && viewItem == sessionDeckSession",
          "group": "inline@3"
        },
        {
          "command": "sessionDeck.viewTranscript",
          "when": "view == sessionDeck.sessions && viewItem == sessionDeckSession",
          "group": "1_modification"
        },
        {
          "command": "sessionDeck.renameSession",
          "when": "view == sessionDeck.sessions && viewItem == sessionDeckSession",
          "group": "1_modification"
        },
        {
          "command": "sessionDeck.archiveSession",
          "when": "view == sessionDeck.sessions && viewItem == sessionDeckSession",
          "group": "1_modification"
        },
        {
          "command": "sessionDeck.copyLastResponse",
          "when": "view == sessionDeck.sessions && viewItem == sessionDeckSession",
          "group": "1_modification"
        },
        {
          "command": "sessionDeck.copySessionInfo",
          "when": "view == sessionDeck.sessions && viewItem == sessionDeckSession",
          "group": "1_modification"
        },
        {
          "command": "sessionDeck.forkSession",
          "when": "view == sessionDeck.sessions && viewItem == sessionDeckSession",
          "group": "1_modification"
        },
        {
          "command": "sessionDeck.openSessionDangerously",
          "when": "view == sessionDeck.sessions && viewItem == sessionDeckSession",
          "group": "2_danger"
        },
        {
          "command": "sessionDeck.forkSessionDangerously",
          "when": "view == sessionDeck.sessions && viewItem == sessionDeckSession",
          "group": "2_danger"
        },
        {
          "command": "sessionDeck.viewTranscript",
          "when": "view == sessionDeck.sessions && viewItem == sessionDeckArchivedSession",
          "group": "inline@1"
        },
        {
          "command": "sessionDeck.renameSession",
          "when": "view == sessionDeck.sessions && viewItem == sessionDeckArchivedSession",
          "group": "inline@2"
        },
        {
          "command": "sessionDeck.unarchiveSession",
          "when": "view == sessionDeck.sessions && viewItem == sessionDeckArchivedSession",
          "group": "inline@3"
        },
        {
          "command": "sessionDeck.viewTranscript",
          "when": "view == sessionDeck.sessions && viewItem == sessionDeckArchivedSession",
          "group": "1_modification"
        },
        {
          "command": "sessionDeck.renameSession",
          "when": "view == sessionDeck.sessions && viewItem == sessionDeckArchivedSession",
          "group": "1_modification"
        },
        {
          "command": "sessionDeck.unarchiveSession",
          "when": "view == sessionDeck.sessions && viewItem == sessionDeckArchivedSession",
          "group": "1_modification"
        },
        {
          "command": "sessionDeck.copyLastResponse",
          "when": "view == sessionDeck.sessions && viewItem == sessionDeckArchivedSession",
          "group": "1_modification"
        },
        {
          "command": "sessionDeck.copySessionInfo",
          "when": "view == sessionDeck.sessions && viewItem == sessionDeckArchivedSession",
          "group": "1_modification"
        },
        {
          "command": "sessionDeck.forkSession",
          "when": "view == sessionDeck.sessions && viewItem == sessionDeckArchivedSession",
          "group": "1_modification"
        },
        {
          "command": "sessionDeck.openSessionDangerously",
          "when": "view == sessionDeck.sessions && viewItem == sessionDeckArchivedSession",
          "group": "2_danger"
        },
        {
          "command": "sessionDeck.forkSessionDangerously",
          "when": "view == sessionDeck.sessions && viewItem == sessionDeckArchivedSession",
          "group": "2_danger"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile",
    "test": "node --test out/test/suite/*.test.js",
    "lint": "eslint src"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^20.11.0",
    "@types/node-notifier": "^8.0.5",
    "@types/vscode": "^1.93.0",
    "eslint": "^10.11.0",
    "typescript": "^5.4.0",
    "typescript-eslint": "^8.70.1"
  },
  "dependencies": {
    "node-notifier": "^10.0.1"
  }
}
